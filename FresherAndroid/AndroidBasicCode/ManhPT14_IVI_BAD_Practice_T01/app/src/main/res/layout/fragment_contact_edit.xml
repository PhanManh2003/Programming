<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">
    <!--  LinearLayout thẳng đứng cho form — đơn giản và nhanh  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <!--  Chọn ảnh đại diện  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <FrameLayout
                android:id="@+id/frameEditAvatar"
                android:layout_width="90dp"
                android:layout_height="90dp">

                <ImageView
                    android:id="@+id/imgEditAvatar"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/circle_avatar_large_bg"
                    android:clipToOutline="true"
                    android:contentDescription="@string/label_photo"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvEditAvatarLetter"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/circle_avatar_large_bg"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="@color/white"
                    android:textSize="36sp"
                    android:textStyle="bold" />
                <!--  Overlay icon camera  -->
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/circle_avatar_bg"
                    android:contentDescription="@null"
                    android:padding="4dp"
                    android:src="@drawable/ic_edit" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tap to change photo"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp" />
        </LinearLayout>
        <!--  Label: Name  -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/hint_name"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />
        <!--  Input: Tên  -->
        <EditText
            android:id="@+id/etEditName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_field"
            android:hint="Full Name"
            android:imeOptions="actionNext"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />
        <!--  Label: Phone  -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/hint_phone"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />
        <!--  Input: Số điện thoại  -->
        <EditText
            android:id="@+id/etEditPhone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_field"
            android:hint="Phone Number"
            android:imeOptions="actionNext"
            android:inputType="phone"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />
        <!--  Label: Email  -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/hint_email"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />
        <!--  Input: Email  -->
        <EditText
            android:id="@+id/etEditEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_field"
            android:hint="Email (optional)"
            android:imeOptions="actionDone"
            android:inputType="textEmailAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />
        <!--  Row buttons: Cancel + Save  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">
            <!--  Cancel  -->
            <Button
                android:id="@+id/btnCancel"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/btn_cancel"
                android:textAllCaps="false"
                android:textColor="@color/textSecondary"
                android:textSize="14sp" />
            <!--  Save  -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_edit"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/btn_save"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>