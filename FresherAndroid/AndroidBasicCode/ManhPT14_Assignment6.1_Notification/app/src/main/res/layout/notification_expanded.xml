<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1C1B1F"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Row 1: Album art + Tên bài + Nút collapse + Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_album_art_exp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:src="@drawable/album_art" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_song_title_exp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I Ain't Worried - Acoustic"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tv_artist_exp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OneRepublic"
                android:textColor="#BBBBBB"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Nút thu gọn lại (collapse) -->
        <ImageButton
            android:id="@+id/btn_collapse"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@null"
            android:contentDescription="Collapse"
            android:src="@drawable/ic_expand_less" />

        <!-- Nút đóng -->
        <ImageButton
            android:id="@+id/btn_close_exp"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@null"
            android:contentDescription="Close"
            android:src="@drawable/ic_close" />

    </LinearLayout>

    <!-- Row 2: Progress bar , ko dùng seek bar vì ko dc RemoteViews hỗ trợ -->
    <ProgressBar
        android:id="@+id/progress_exp"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:progress="30"
        android:max="100" />

    <!-- Row 3: Các nút điều khiển -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

        <ImageButton
            android:id="@+id/btn_prev_exp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@null"
            android:src="@drawable/ic_skip_previous"
            android:contentDescription="Previous"/>

        <ImageButton
            android:id="@+id/btn_play_pause_exp"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/circle_button_bg"
            android:src="@drawable/ic_pause_dark"
            android:contentDescription="Play/Pause"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>

        <ImageButton
            android:id="@+id/btn_next_exp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@null"
            android:src="@drawable/ic_skip_next"
            android:contentDescription="Next"/>

    </LinearLayout>

</LinearLayout>